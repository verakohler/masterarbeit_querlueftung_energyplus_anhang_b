! ==============================================================================
! AFN_E+_Jahr.idf
! ==============================================================================
! Modellansatz      : AirflowNetwork, MultiZone:Component:DetailedOpening, SurfaceAverageCalculation
! Geometrie         : Hallenstueck 15 x 60 x 12 m, A = 900 m2, V = 10800 m3
! Tore              : alle sechs, schedulegesteuert
! Gebaeudedrehung   : 0 Grad (Tore in Sued/Nord)
!                     Tor 1-3 (AW_Sued) <- AN_1..3, Tor 4-6 (AW_Nord) <- AB_1..3
! Wetterdatei       : DEU_Munich.108660_IWEC.epw (Stundenwerte, unveraendert)
! Windprofil        : EnergyPlus-Standard (Terrain Country)
! Zeitraum          : 1.1. bis 31.12.
! Timestep          : 60 pro Stunde
! Sollwert          : 17 Grad C konstant, keine Nachtabsenkung
! Auswertung        : Oktober bis April, 5088 h
! EnergyPlus        : 25.2
!
! Erzeugt von make_heizperiode.py. Setzungen siehe README_Heizperiode.md.
!
! STUFE 2 - Referenzlauf AFN_E+.
! Crack-Koeffizient C = 0.023715 kg/s bei 1 Pa (aus Stufe 1).
! 
! Liefert Q_AFN je Zeitschritt fuer die Kalibrierung der DFR-Objekte:
!   Q_design = Summe(Q_AFN * dt) / Summe(Summe_i(s_i) * dt)
! mit s_i dem Schedulewert von Tor i. Damit trifft DFR_DEFAULT den
! kumulierten Aussenluftaustausch exakt; BLAST und DOE-2 weichen allein
! durch ihre Koeffizientensaetze ab (Innen-Spanne fuer 6.3.2).
! ==============================================================================


!- ============================================================================
!-   VERSION, SIMULATIONCONTROL, BUILDING, TIMESTEP
!- ============================================================================

Version,
    25.2;                    !- Version Identifier

SimulationControl,
    No,                      !- Do Zone Sizing Calculation
    No,                      !- Do System Sizing Calculation
    No,                      !- Do Plant Sizing Calculation
    No,                      !- Run Simulation for Sizing Periods
    Yes,                     !- Run Simulation for Weather File Run Periods
    ,                        !- Do HVAC Sizing Simulation for Sizing Periods
    ;                        !- Maximum Number of HVAC Sizing Simulation Passes

!- Die Anstroemrichtung kommt aus der unveraenderten Wetterdatei, nicht
!- mehr aus einer konstruierten EPW wie in Kapitel 5. Die Gebaeudedrehung
!- betraegt 0 Grad: Toroeffnungen in Sued- und Nordfassade.
!- Mitgedreht sind zusaetzlich Effective Angle (WSOA) und Azimuth Angle of
!- Long Axis (AFN) - beide folgen North Axis nicht selbsttaetig.
Building,
    Halle_15x60x12,          !- Name
    0,                       !- North Axis {deg}
    Country,                 !- Terrain
    ,                        !- Loads Convergence Tolerance Value {W}
    ,                        !- Temperature Convergence Tolerance Value {deltaC}
    ,                        !- Solar Distribution
    ,                        !- Maximum Number of Warmup Days
    6;                       !- Minimum Number of Warmup Days

Timestep,
    60;                      !- Number of Timesteps per Hour


!- ============================================================================
!-   SITE
!- ============================================================================

Site:Location,
    Muenchen_Bayern_DEU,     !- Name
    48.13,                   !- Latitude {deg}
    11.70,                   !- Longitude {deg}
    1,                       !- Time Zone {hr}
    529;                     !- Elevation {m}

!- Kein Site:WeatherStation und kein Site:HeightVariation. Das flache
!- Windprofil aus Kapitel 5 war eine Verifikationsmassnahme, damit
!- Handrechnung, ZoneVentilation, WSOA und die AFN-External-Nodes dieselbe
!- Geschwindigkeit sehen. In Kapitel 6 gibt es keine Handrechnung mehr; ein
!- flaches Profil wuerde die Bezugshoehen der drei Modellansaetze kuenstlich
!- gleichsetzen und damit einen Teil der Zwischen-Spanne wegdefinieren.
!- Erdreichtemperatur = Sollwert minus 2 K = 15 Grad C, konstant ueber alle
!- zwoelf Monate. Quelle: EnergyPlus Input Output Reference, Abschnitt
!- Site:GroundTemperature:BuildingSurface: 'When considering a typical
!- commercial building in the USA, a reasonable default value is 2 C less
!- than the average indoor space temperature if the user elects to not run
!- either the Slab or Basement program.' Die dort ebenfalls genannten
!- ungestoerten Bodentemperaturen aus der Wetterdatei sind laut derselben
!- Quelle fuer Gebaeudeverluste ausdruecklich nicht geeignet.
!- Der Bodenanteil ist in allen fuenf Modellen identisch und faellt in der
!- Differenz zwischen den Modellen heraus, nicht aber im Absolutwert.
Site:GroundTemperature:BuildingSurface,
    15,                      !- January Ground Temperature {C}
    15,                      !- February Ground Temperature {C}
    15,                      !- March Ground Temperature {C}
    15,                      !- April Ground Temperature {C}
    15,                      !- May Ground Temperature {C}
    15,                      !- June Ground Temperature {C}
    15,                      !- July Ground Temperature {C}
    15,                      !- August Ground Temperature {C}
    15,                      !- September Ground Temperature {C}
    15,                      !- October Ground Temperature {C}
    15,                      !- November Ground Temperature {C}
    15;                      !- December Ground Temperature {C}


!- ============================================================================
!-   RUNPERIOD
!- ============================================================================

RunPeriod,
    Jahr,                    !- Name
    1,                       !- Begin Month
    1,                       !- Begin Day of Month
    ,                        !- Begin Year
    12,                      !- End Month
    31,                      !- End Day of Month
    ,                        !- End Year
    Thursday,                !- Day of Week for Start Day
    No,                      !- Use Weather File Holidays and Special Days
    No,                      !- Use Weather File Daylight Saving Period
    No,                      !- Apply Weekend Holiday Rule
    Yes,                     !- Use Weather File Rain Indicators
    Yes;                     !- Use Weather File Snow Indicators


!- ============================================================================
!-   SCHEDULES
!- ============================================================================

ScheduleTypeLimits,
    Fractional,              !- Name
    0,                       !- Lower Limit Value
    1,                       !- Upper Limit Value
    Continuous;              !- Numeric Type

ScheduleTypeLimits,
    Temperature,             !- Name
    -60,                     !- Lower Limit Value
    200,                     !- Upper Limit Value
    Continuous,              !- Numeric Type
    Temperature;             !- Unit Type

ScheduleTypeLimits,
    Control Type,            !- Name
    0,                       !- Lower Limit Value
    4,                       !- Upper Limit Value
    Discrete,                !- Numeric Type
    Control;                 !- Unit Type

Schedule:Constant,
    Sch_Immer_an,            !- Name
    Fractional,              !- Schedule Type Limits Name
    1.0;                     !- Hourly Value

!- Heizsollwert konstant, keine Nachtabsenkung. Begruendung: eine Absenkung
!- legt die Aufheizspitze auf den Schichtbeginn und damit genau auf den
!- Beginn des Torbetriebs. Spitzenlast (6.4.2) und Lastgradient (6.4.3)
!- wuerden dann eine Ueberlagerung aus Anlagenfahrweise und Torlueftung
!- messen statt der Torlueftung allein.
Schedule:Constant,
    Sch_T_soll,              !- Name
    Temperature,             !- Schedule Type Limits Name
    17;                      !- Hourly Value

Schedule:Constant,
    Sch_Regelungsart,        !- Name
    Control Type,            !- Schedule Type Limits Name
    1;                       !- Hourly Value

!- Nutzungsprofil der internen Gewinne, uebernommen aus AFN_paper_Vorlage.idf
!- (Schedule 'Geraete': Werktags 07:00 bis 16:00).
Schedule:Compact,
    Sch_Geraete,             !- Name
    Fractional,              !- Schedule Type Limits Name
    Through: 12/31,
    For: Weekdays,
    Until: 07:00,0.0,
    Until: 16:00,1.0,
    Until: 24:00,0.0,
    For: AllOtherDays,
    Until: 24:00,0.0;

!- Tor-Schedules, uebernommen aus alle_tore.idf (gate_scheduling 0.1.0, Seed 42).
!- Minutenaufloesung; wirkt nur bei Timestep 60.

ScheduleTypeLimits,
    Fraction,                !- Name
    0.0,                     !- Lower Limit Value
    1.0,                     !- Upper Limit Value
    Continuous;              !- Numeric Type

Schedule:Compact,
    AN_1_Tor_Schedule,       !- Name
    Fraction,                !- Schedule Type Limits Name
