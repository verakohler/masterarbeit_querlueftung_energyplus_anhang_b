!- ============================================================================
!-   THERMOSTAT UND IDEAL LOADS
!- ============================================================================

!- Reiner Heizfall: SingleHeating, Regelungsart 1. Kuehlung ist nach 4.1.1
!- ausdruecklich ausgeschlossen.
ZoneControl:Thermostat,
    Thermostat,              !- Name
    Zone_Halle,              !- Zone or ZoneList Name
    Sch_Regelungsart,        !- Control Type Schedule Name
    ThermostatSetpoint:SingleHeating, !- Control 1 Object Type
    Sollwert_Heizen;         !- Control 1 Name

ThermostatSetpoint:SingleHeating,
    Sollwert_Heizen,         !- Name
    Sch_T_soll;              !- Setpoint Temperature Schedule Name

!- Heizleistung unbegrenzt (NoLimit). Eine leistungsbegrenzte Versorgung
!- wuerde die Spanne von der Last in die Zonentemperatur verschieben; das
!- ist als Ausblick in Kapitel 8 vermerkt, nicht Gegenstand dieser Arbeit.
ZoneHVAC:IdealLoadsAirSystem,
    IdealLoads,              !- Name
    ,                        !- Availability Schedule Name
    Inlet_Node,              !- Zone Supply Air Node Name
    ,                        !- Zone Exhaust Air Node Name
    ,                        !- System Inlet Air Node Name
    50,                      !- Maximum Heating Supply Air Temperature {C}
    13,                      !- Minimum Cooling Supply Air Temperature {C}
    0.0156,                  !- Maximum Heating Supply Air Humidity Ratio {kgWater/kgDryAir}
    0.0077,                  !- Minimum Cooling Supply Air Humidity Ratio {kgWater/kgDryAir}
    NoLimit,                 !- Heating Limit
    ,                        !- Maximum Heating Air Flow Rate {m3/s}
    ,                        !- Maximum Sensible Heating Capacity {W}
    NoLimit,                 !- Cooling Limit
    ,                        !- Maximum Cooling Air Flow Rate {m3/s}
    ,                        !- Maximum Total Cooling Capacity {W}
    ,                        !- Heating Availability Schedule Name
    ,                        !- Cooling Availability Schedule Name
    None,                    !- Dehumidification Control Type
    ,                        !- Cooling Sensible Heat Ratio {dimensionless}
    None,                    !- Humidification Control Type
    ,                        !- Design Specification Outdoor Air Object Name
    ,                        !- Outdoor Air Inlet Node Name
    None,                    !- Demand Controlled Ventilation Type
    NoEconomizer,            !- Outdoor Air Economizer Type
    None,                    !- Heat Recovery Type
    ,                        !- Sensible Heat Recovery Effectiveness {dimensionless}
    ;                        !- Latent Heat Recovery Effectiveness {dimensionless}

ZoneHVAC:EquipmentList,
    EquipmentList,           !- Name
    SequentialLoad,          !- Load Distribution Scheme
    ZoneHVAC:IdealLoadsAirSystem, !- Zone Equipment 1 Object Type
    IdealLoads,              !- Zone Equipment 1 Name
    1,                       !- Zone Equipment 1 Cooling Sequence
    1,                       !- Zone Equipment 1 Heating or No-Load Sequence
    ,                        !- Zone Equipment 1 Sequential Cooling Fraction Schedule Name
    ;                        !- Zone Equipment 1 Sequential Heating Fraction Schedule Name

ZoneHVAC:EquipmentConnections,
    Zone_Halle,              !- Zone Name
    EquipmentList,           !- Zone Conditioning Equipment List Name
    Inlet_Node,              !- Zone Air Inlet Node or NodeList Name
    ,                        !- Zone Air Exhaust Node or NodeList Name
    Zone_Node,               !- Zone Air Node Name
    Return_Node;             !- Zone Return Air Node or NodeList Name


!- ============================================================================
!-   INTERNE GEWINNE UND SPEICHERMASSE
!- ============================================================================

!- Uebernommen aus dem Referenzmodell hinter Kohler et al. (2025)
!- (Hausladen et al.), dort fuer eine Halle mit 67.2 m2 Grundflaeche.
!- Skaliert mit dem Verhaeltnis der Grundflaechen 900 / 67.2 = 13.3929.
!- ANNAHME: interne Gewinne und Speichermasse sind an die Nutzflaeche
!- gebunden (Regal, Ware, Flurfoerderzeuge), nicht an das Luftvolumen.
!- Die Referenzhalle ist 4,80 m hoch, diese Halle 12,00 m - eine
!- volumenbezogene Skalierung ergaebe den Faktor 33,48 statt 13.3929.
ElectricEquipment,
    Interne_Gewinne_Geraete, !- Name
    Zone_Halle,              !- Zone or ZoneList or Space or SpaceList Name
    Sch_Geraete,             !- Schedule Name
    EquipmentLevel,          !- Design Level Calculation Method
    9375,                    !- Design Level {W}
    ,                        !- Watts per Floor Area {W/m2}
    ,                        !- Watts per Person {W/person}
    ,                        !- Fraction Latent
    ,                        !- Fraction Radiant
    ,                        !- Fraction Lost
    General;                 !- End-Use Subcategory

InternalMass,
    Interne_Masse_Metall,    !- Name
    Metall_IM,               !- Construction Name
    Zone_Halle,              !- Zone or ZoneList Name
    ,                        !- Space or SpaceList Name
    1607.14;                 !- Surface Area {m2}

InternalMass,
    Interne_Masse_Holz,      !- Name
    Holz_IM,                 !- Construction Name
    Zone_Halle,              !- Zone or ZoneList Name
    ,                        !- Space or SpaceList Name
    803.57;                  !- Surface Area {m2}


!- ============================================================================
!-   AIRFLOWNETWORK
!- ============================================================================

!- Wind Pressure Coefficient Type = SurfaceAverageCalculation wie in
!- Kapitel 5 (Modellansatz AFN_E+). Azimuth Angle of Long Axis = 0 Grad
!- (Laengsachse 60 m, mit dem Gebaeude gedreht),
!- Ratio Short/Long = 0.25.
AirflowNetwork:SimulationControl,
    AFN_Heizperiode,         !- Name
    MultizoneWithoutDistribution, !- AirflowNetwork Control
    SurfaceAverageCalculation, !- Wind Pressure Coefficient Type
    ExternalNode,            !- Height Selection for Local Wind Pressure Calculation
    LowRise,                 !- Building Type
    500,                     !- Maximum Number of Iterations {dimensionless}
    LinearInitializationMethod, !- Initialization Type
    0.0001,                  !- Relative Airflow Convergence Tolerance {dimensionless}
    0.000001,                !- Absolute Airflow Convergence Tolerance {kg/s}
    -0.5,                    !- Convergence Acceleration Limit {dimensionless}
    0,                       !- Azimuth Angle of Long Axis of Building {deg}
    0.25,                    !- Ratio of Building Width Along Short Axis to Width Along Long Axis
    No,                      !- Height Dependence of External Node Temperature
    SkylineLU,               !- Solver
    No,                      !- Allow Unsupported Zone Equipment
    No;                      !- Do Distribution Duct Sizing Calculation

AirflowNetwork:MultiZone:Zone,
    Zone_Halle,              !- Zone Name
    Constant,                !- Ventilation Control Mode
    ,                        !- Ventilation Control Zone Temperature Setpoint Schedule Name
    ,                        !- Minimum Venting Open Factor {dimensionless}
    0,                       !- Indoor and Outdoor Temperature Difference Lower Limit For Maximum Venting Open Factor {deltaC}
    100,                     !- Indoor and Outdoor Temperature Difference Upper Limit for Minimum Venting Open Factor {deltaC}
    0,                       !- Indoor and Outdoor Enthalpy Difference Lower Limit For Maximum Venting Open Factor {deltaJ/kg}
    300000;                  !- Indoor and Outdoor Enthalpy Difference Upper Limit for Minimum Venting Open Factor {deltaJ/kg}

!- Grundinfiltration als Huellenleckage. ZoneInfiltration:DesignFlowRate
!- ist unter AirflowNetwork Control = MultizoneWithoutDistribution
!- unwirksam - die Input Output Reference 25.2 sagt dazu woertlich: 'Any
!- ZoneInfiltration:*, ZoneVentilation:*, ZoneMixing and ZoneCrossMixing
!- objects specified in the input data file are not simulated.'
!- Der Koeffizient ist auf die Netto-Aussenflaechen verteilt
!- (AW_Sued 153 m2, AW_Nord 153 m2, Dach 900 m2, Summe 1206 m2) und in
!- Stufe 1 so kalibriert, dass das Heizperiodenmittel 0.025 1/h betraegt.
AirflowNetwork:MultiZone:Surface:Crack,
    Crack_AW_Sued,           !- Name
    0.00300865,              !- Air Mass Flow Coefficient at Reference Conditions {kg/s}
    0.65;                    !- Air Mass Flow Exponent {dimensionless}

AirflowNetwork:MultiZone:Surface,
    AW_Sued,                 !- Surface Name
    Crack_AW_Sued,           !- Leakage Component Name
    ,                        !- External Node Name
    1,                       !- Window/Door Opening Factor, or Crack Factor {dimensionless}
    Constant;                !- Ventilation Control Mode

AirflowNetwork:MultiZone:Surface:Crack,
    Crack_AW_Nord,           !- Name
    0.00300865,              !- Air Mass Flow Coefficient at Reference Conditions {kg/s}
    0.65;                    !- Air Mass Flow Exponent {dimensionless}

AirflowNetwork:MultiZone:Surface,
    AW_Nord,                 !- Surface Name
    Crack_AW_Nord,           !- Leakage Component Name
    ,                        !- External Node Name
    1,                       !- Window/Door Opening Factor, or Crack Factor {dimensionless}
    Constant;                !- Ventilation Control Mode

AirflowNetwork:MultiZone:Surface:Crack,
    Crack_Dach,              !- Name
    0.01769797,              !- Air Mass Flow Coefficient at Reference Conditions {kg/s}
    0.65;                    !- Air Mass Flow Exponent {dimensionless}

AirflowNetwork:MultiZone:Surface,
    Dach,                    !- Surface Name
    Crack_Dach,              !- Leakage Component Name
    ,                        !- External Node Name
    1,                       !- Window/Door Opening Factor, or Crack Factor {dimensionless}
    Constant;                !- Ventilation Control Mode

!- Ein AirflowNetwork:MultiZone:Surface je Tor. Der Oeffnungsfaktor wird
!- NICHT ueber Venting Availability gesteuert: dieses Feld ist rein
!- binaer ('A value greater than zero means venting can occur',
!- Input Output Reference 25.2). Der Zwischenwert 0,048 des
!- Andockzustands wuerde dort als voll geoeffnetes Tor gelesen.
!- Die Steuerung erfolgt deshalb ueber den EMS-Aktor weiter unten.
AirflowNetwork:MultiZone:Surface,
    gate 1,                  !- Surface Name
    AFN_Tor,                 !- Leakage Component Name
    ,                        !- External Node Name
    1,                       !- Window/Door Opening Factor, or Crack Factor {dimensionless}
    Constant,                !- Ventilation Control Mode
    ,                        !- Ventilation Control Zone Temperature Setpoint Schedule Name
    ,                        !- Minimum Venting Open Factor {dimensionless}
    ,                        !- Indoor and Outdoor Temperature Difference Lower Limit For Maximum Venting Open Factor {deltaC}
    100,                     !- Indoor and Outdoor Temperature Difference Upper Limit for Minimum Venting Open Factor {deltaC}
    ,                        !- Indoor and Outdoor Enthalpy Difference Lower Limit For Maximum Venting Open Factor {deltaJ/kg}
    300000,                  !- Indoor and Outdoor Enthalpy Difference Upper Limit for Minimum Venting Open Factor {deltaJ/kg}
    Sch_Immer_an,            !- Venting Availability Schedule Name
    ,                        !- Occupant Ventilation Control Name
    PolygonHeight,           !- Equivalent Rectangle Method
    1;                       !- Equivalent Rectangle Aspect Ratio {dimensionless}

AirflowNetwork:MultiZone:Surface,
    gate 2,                  !- Surface Name
    AFN_Tor,                 !- Leakage Component Name
    ,                        !- External Node Name
    1,                       !- Window/Door Opening Factor, or Crack Factor {dimensionless}
    Constant,                !- Ventilation Control Mode
    ,                        !- Ventilation Control Zone Temperature Setpoint Schedule Name
    ,                        !- Minimum Venting Open Factor {dimensionless}
    ,                        !- Indoor and Outdoor Temperature Difference Lower Limit For Maximum Venting Open Factor {deltaC}
    100,                     !- Indoor and Outdoor Temperature Difference Upper Limit for Minimum Venting Open Factor {deltaC}
    ,                        !- Indoor and Outdoor Enthalpy Difference Lower Limit For Maximum Venting Open Factor {deltaJ/kg}
    300000,                  !- Indoor and Outdoor Enthalpy Difference Upper Limit for Minimum Venting Open Factor {deltaJ/kg}
    Sch_Immer_an,            !- Venting Availability Schedule Name
