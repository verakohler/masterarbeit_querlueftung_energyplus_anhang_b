    MediumSmooth,            !- Roughness
    0.0508,                  !- Thickness {m}
    0.15,                    !- Conductivity {W/m-K}
    608,                     !- Density {kg/m3}
    1630;                    !- Specific Heat {J/kg-K}

WindowMaterial:SimpleGlazingSystem,
    Glazing_Tor,             !- Name
    1.8,                     !- U-Factor {W/m2-K}
    0.0001;                  !- Solar Heat Gain Coefficient

Construction,
