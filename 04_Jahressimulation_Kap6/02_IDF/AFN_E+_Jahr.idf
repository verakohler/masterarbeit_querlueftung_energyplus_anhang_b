EnergyManagementSystem:Program,
    Prog_Toroeffnung,        !- Name
    SET Act_Tor1 = Sens_Tor1,
    SET Act_Tor2 = Sens_Tor2,
    SET Act_Tor3 = Sens_Tor3,
    SET Act_Tor4 = Sens_Tor4,
    SET Act_Tor5 = Sens_Tor5,
    SET Act_Tor6 = Sens_Tor6;

EnergyManagementSystem:ProgramCallingManager,
    Mgr_Toroeffnung,         !- Name
    BeginTimestepBeforePredictor, !- EnergyPlus Model Calling Point
    Prog_Toroeffnung;        !- Program Name 1


