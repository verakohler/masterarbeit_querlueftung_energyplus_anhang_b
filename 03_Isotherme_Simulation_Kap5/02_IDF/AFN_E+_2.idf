! ==============================================================================
! AFN_E+_2.idf
! ==============================================================================
! Modellansatz      : AirflowNetwork, MultiZone:Component:DetailedOpening, Winddruckbeiwerte SurfaceAverageCalculation
! Variante          : 2 - Tore 2 + 5 gegenueberliegend, innere Barriere mit Spalt, schraege Anstroemung
! Offene Tore       : Tor 2, Tor 5
! Innere Barriere   : ja, zwei Zonen, Spalt als Oeffnung b = 14.98 m, h = 2.00267 m, A = 30 m2
! Wetterdatei       : DEU_Munich.108660_Isotherm-WSW2475-u5072.epw
! Windrichtung      : 247.5 Grad (meteorologisch)
! Windgeschwindigk. : 5.071965 m/s in jeder Hoehe (flaches Profil, Exponent 0)
!                     = 6.5 * (1.7/10)^0.14, Blatt Wetter
! Randbedingung     : isotherm, T_aussen = T_zone = 17 Grad C
! EnergyPlus        : 25.2
!
! Werte aus Handrechnungen_neu.xlsx. Erzeugt von make_isotherm_varianten.py.
! Keine Undichtheiten (kein AFN_Crack, kein ZoneInfiltration) und keine
! internen Lasten: die Datei prueft ausschliesslich den Toranteil gegen die
! Handrechnung.
!
! Sollwerte fuer die Verifikation (Blatt AFN_1Zone bzw. AFN_2Zonen):
!   C_p AW_Sued (Tor 2)      = 0.033   (von EnergyPlus selbst berechnet)
!   C_p AW_Nord (Tor 4/5)    = -0.44
!   Delta C_p                = 0.473
!   Staudruck 0,5*rho*u^2    = 14.717 Pa (rho = 1.14419 kg/m3 bei 17 Grad C, 95300 Pa)
!   Gesamtdruckdifferenz     = 6.9612 Pa
!   davon je Tor             = 3.3307 Pa
!   davon am Spalt           = 0.2998 Pa
!   A_eff (Reihenschaltung)  = 6.22543 m2
!   Q_vent                   = 13.4638 m3/s
!   Luftwechsel (V = 10800 m3) = 4.4879 1/h
!   Der Luftwechsel bezieht sich auf das Gesamtvolumen. Die beiden Zonen
!   fuehren je 5400 m3; EnergyPlus gibt AFN Zone Infiltration je Zone aus.
! ==============================================================================


!- ============================================================================
!-   VERSION, SIMULATIONCONTROL, BUILDING, TIMESTEP
!- ============================================================================

Version,
    25.2;                    !- Version Identifier

SimulationControl,
    No,                      !- Do Zone Sizing Calculation
    No,                      !- Do System Sizing Calculation
    No,                      !- Do Plant Sizing Calculation
    No,                      !- Run Simulation for Sizing Periods
    Yes,                     !- Run Simulation for Weather File Run Periods
    ,                        !- Do HVAC Sizing Simulation for Sizing Periods
    ;                        !- Maximum Number of HVAC Sizing Simulation Passes

!- North Axis 0: Gebaeude fest orientiert. Die Anstroemrichtung wird ueber
!- die Wetterdatei gedreht, nicht ueber das Gebaeude - so bleiben Effective
!- Angle und AFN-Azimut unveraendert und die Handrechnung vergleichbar.
Building,
    Halle_15x60x12,          !- Name
    0,                       !- North Axis {deg}
    Country,                 !- Terrain
    ,                        !- Loads Convergence Tolerance Value {W}
    ,                        !- Temperature Convergence Tolerance Value {deltaC}
    ,                        !- Solar Distribution
    ,                        !- Maximum Number of Warmup Days
    6;                       !- Minimum Number of Warmup Days

Timestep,
    4;                       !- Number of Timesteps per Hour


!- ============================================================================
!-   SITE
!- ============================================================================

Site:Location,
    Muenchen_Bayern_DEU,     !- Name
    48.13,                   !- Latitude {deg}
    11.70,                   !- Longitude {deg}
    1,                       !- Time Zone {hr}
    529;                     !- Elevation {m}

!- Flaches Windprofil in beiden Objekten und Temperaturgradient 0.
!- Nachgewiesen in Notiz_Windprofil_Verifikation_Sollwerte.md, Lauf B2:
!- alle Zonen und alle External Nodes sehen u = u_EPW, Delta-T exakt 0.
!- Site:WeatherStation ist bei Exponent 0 nicht zwingend (Lauf B1), wird
!- aber gesetzt, damit das flache Profil explizit im Eingabefile steht.
Site:WeatherStation,
    10.0,                    !- Wind Sensor Height Above Ground {m}
    0.0,                     !- Wind Speed Profile Exponent
    270,                     !- Wind Speed Profile Boundary Layer Thickness {m}
    1.5;                     !- Air Temperature Sensor Height Above Ground {m}

Site:HeightVariation,
    0.0,                     !- Wind Speed Profile Exponent
    270,                     !- Wind Speed Profile Boundary Layer Thickness {m}
    0.0;                     !- Air Temperature Gradient Coefficient {K/m}

!- Erdreichtemperatur = Zonentemperatur, damit der Boden keinen
!- Waermestrom erzeugt und die Zone ohne Anlagenleistung isotherm bleibt.
Site:GroundTemperature:BuildingSurface,
    17,                      !- January Ground Temperature {C}
    17,                      !- February Ground Temperature {C}
    17,                      !- March Ground Temperature {C}
    17,                      !- April Ground Temperature {C}
    17,                      !- May Ground Temperature {C}
    17,                      !- June Ground Temperature {C}
    17,                      !- July Ground Temperature {C}
    17,                      !- August Ground Temperature {C}
    17,                      !- September Ground Temperature {C}
    17,                      !- October Ground Temperature {C}
    17,                      !- November Ground Temperature {C}
    17;                      !- December Ground Temperature {C}


!- ============================================================================
!-   RUNPERIOD
!- ============================================================================

!- Die Wetterdatei enthaelt genau einen Tag (15.01.) mit 24 identischen
!- Stundenwerten. Auswertung an einem beliebigen Zeitschritt nach Warmup.
RunPeriod,
    Isotherm_15Jan,          !- Name
    1,                       !- Begin Month
    15,                      !- Begin Day of Month
    ,                        !- Begin Year
    1,                       !- End Month
    15,                      !- End Day of Month
    ,                        !- End Year
    Wednesday,               !- Day of Week for Start Day
    No,                      !- Use Weather File Holidays and Special Days
    No,                      !- Use Weather File Daylight Saving Period
    No,                      !- Apply Weekend Holiday Rule
    No,                      !- Use Weather File Rain Indicators
    No;                      !- Use Weather File Snow Indicators


!- ============================================================================
!-   SCHEDULES
!- ============================================================================

ScheduleTypeLimits,
    Fractional,              !- Name
    0,                       !- Lower Limit Value
    1,                       !- Upper Limit Value
    Continuous;              !- Numeric Type

ScheduleTypeLimits,
    Temperature,             !- Name
    -60,                     !- Lower Limit Value
    200,                     !- Upper Limit Value
    Continuous,              !- Numeric Type
    Temperature;             !- Unit Type

ScheduleTypeLimits,
    Control Type,            !- Name
    0,                       !- Lower Limit Value
    4,                       !- Upper Limit Value
    Discrete,                !- Numeric Type
    Control;                 !- Unit Type

Schedule:Constant,
    Sch_Tor_auf,             !- Name
    Fractional,              !- Schedule Type Limits Name
    1.0;                     !- Hourly Value

Schedule:Constant,
    Sch_Tor_zu,              !- Name
    Fractional,              !- Schedule Type Limits Name
    0.0;                     !- Hourly Value

!- Ein einziger Sollwert von 17 Grad C, Regelungsart 3
!- (SingleHeatingOrCooling): die Zone wird sowohl geheizt als auch gekuehlt
!- und haelt damit exakt die Aussentemperatur. Nur so ist Delta-T = 0 und der
!- Auftriebsterm sicher inaktiv.
Schedule:Constant,
    Sch_T_iso,               !- Name
    Temperature,             !- Schedule Type Limits Name
    17;                      !- Hourly Value

Schedule:Constant,
    Sch_Regelungsart,        !- Name
    Control Type,            !- Schedule Type Limits Name
    3;                       !- Hourly Value


!- ============================================================================
!-   MATERIALS AND CONSTRUCTIONS
!- ============================================================================

!- Uebernommen aus AFN_paper_Vorlage.idf. Im isothermen Fall ohne Wirkung
!- (Delta-T = 0, keine Solarstrahlung in der Wetterdatei), aber erhalten,
!- damit dieselbe Huelle im Heizperiodenlauf verwendet werden kann.
Material,
    AW_IW_Obj30_Porenbeton,  !- Name
    MediumRough,             !- Roughness
    0.2032,                  !- Thickness {m}
    0.5,                     !- Conductivity {W/m-K}
    464,                     !- Density {kg/m3}
    880;                     !- Specific Heat {J/kg-K}

Material,
    D_Obj14_Gipskarton,      !- Name
    MediumSmooth,            !- Roughness
    0.0159,                  !- Thickness {m}
    0.16,                    !- Conductivity {W/m-K}
    800,                     !- Density {kg/m3}
    1090;                    !- Specific Heat {J/kg-K}

Material,
    B_Obj43_Beton,           !- Name
    MediumRough,             !- Roughness
    0.2032,                  !- Thickness {m}
    1.95,                    !- Conductivity {W/m-K}
    2240,                    !- Density {kg/m3}
    900;                     !- Specific Heat {J/kg-K}

Material,
    AW_Obj91_Waermedaemmung, !- Name
    Rough,                   !- Roughness
    0.025,                   !- Thickness {m}
    0.0245,                  !- Conductivity {W/m-K}
    24,                      !- Density {kg/m3}
    1590;                    !- Specific Heat {J/kg-K}

Material,
    D_Obj80_Daemmung,        !- Name
    MediumRough,             !- Roughness
    0.05,                    !- Thickness {m}
    0.036,                   !- Conductivity {W/m-K}
    140,                     !- Density {kg/m3}
    960;                     !- Specific Heat {J/kg-K}

Material,
    D_Obj84_XPS,             !- Name
    MediumSmooth,            !- Roughness
    0.025,                   !- Thickness {m}
    0.029,                   !- Conductivity {W/m-K}
    29,                      !- Density {kg/m3}
    1210;                    !- Specific Heat {J/kg-K}

Material,
    D_Obj8_Built-up roofing, !- Name
    Rough,                   !- Roughness
    0.0095,                  !- Thickness {m}
    0.16,                    !- Conductivity {W/m-K}
    1120,                    !- Density {kg/m3}
    1460;                    !- Specific Heat {J/kg-K}

WindowMaterial:SimpleGlazingSystem,
    Glazing_Tor,             !- Name
    1.8,                     !- U-Factor {W/m2-K}
    0.0001;                  !- Solar Heat Gain Coefficient

Construction,
    Aussenwand,              !- Name
    AW_Obj91_Waermedaemmung, !- Outside Layer
    AW_IW_Obj30_Porenbeton;  !- Layer 2

Construction,
    Innenwand,               !- Name
    AW_IW_Obj30_Porenbeton;  !- Outside Layer

Construction,
    Dach,                    !- Name
    D_Obj8_Built-up roofing, !- Outside Layer
    D_Obj80_Daemmung,        !- Layer 2
    D_Obj14_Gipskarton;      !- Layer 3

Construction,
    Boden,                   !- Name
    D_Obj84_XPS,             !- Outside Layer
    B_Obj43_Beton;           !- Layer 2

Construction,
    Tor,                     !- Name
    Glazing_Tor;             !- Outside Layer


!- ============================================================================
!-   GLOBALGEOMETRYRULES
!- ============================================================================

GlobalGeometryRules,
    UpperLeftCorner,         !- Starting Vertex Position
    Counterclockwise,        !- Vertex Entry Direction
    Relative,                !- Coordinate System
    Relative,                !- Daylighting Reference Point Coordinate System
    Relative;                !- Rectangular Surface Coordinate System


!- ============================================================================
!-   ZONES
!- ============================================================================

Zone,
    Zone_Sued,               !- Name
    0,                       !- Direction of Relative North {deg}
    0,                       !- X Origin {m}
    0,                       !- Y Origin {m}
    0,                       !- Z Origin {m}
    ,                        !- Type
    1,                       !- Multiplier
    12,                      !- Ceiling Height {m}
    5400,                    !- Volume {m3}
    450,                     !- Floor Area {m2}
    ,                        !- Zone Inside Convection Algorithm
    ,                        !- Zone Outside Convection Algorithm
    Yes;                     !- Part of Total Floor Area

Zone,
    Zone_Nord,               !- Name
    0,                       !- Direction of Relative North {deg}
    0,                       !- X Origin {m}
    0,                       !- Y Origin {m}
    0,                       !- Z Origin {m}
    ,                        !- Type
    1,                       !- Multiplier
    12,                      !- Ceiling Height {m}
    5400,                    !- Volume {m3}
    450,                     !- Floor Area {m2}
    ,                        !- Zone Inside Convection Algorithm
    ,                        !- Zone Outside Convection Algorithm
    Yes;                     !- Part of Total Floor Area


