!- ============================================================================
!-   ZONEVENTILATION:WINDANDSTACKOPENAREA
!- ============================================================================

!- Ein Objekt je geoeffnetem Tor. Height Difference = 0, weil beide Tore auf
!- gleicher Hoehe sitzen und die neutrale Ebene damit in Toroeffnungsmitte
!- liegt - der Auftriebsterm ist strukturell null.
!- Discharge Coefficient = Autocalculate ergibt 0,40 + 0,0045*|dT| = 0,40;
!- ohne Wirkung, da Height Difference = 0.
!- Delta Temperature = -100 K und die Temperaturgrenzen +/-100 Grad C
!- verhindern, dass das Objekt bei dT = 0 auf der Abschaltschwelle liegt.
!- Tor 2 in AW_Sued: C_w = 0.425, Q_soll = 19.4003 m3/s
ZoneVentilation:WindandStackOpenArea,
    WSOA_Tor2,               !- Name
    Zone_Sued,               !- Zone or Space Name
    9,                       !- Opening Area {m2}
    Sch_Tor_auf,             !- Opening Area Fraction Schedule Name
    Autocalculate,           !- Opening Effectiveness
    180,                     !- Effective Angle {deg}
    0.0,                     !- Height Difference {m}
    Autocalculate,           !- Discharge Coefficient for Opening
    -100.0,                  !- Minimum Indoor Temperature {C}
    ,                        !- Minimum Indoor Temperature Schedule Name
    100.0,                   !- Maximum Indoor Temperature {C}
    ,                        !- Maximum Indoor Temperature Schedule Name
    -100.0,                  !- Delta Temperature {deltaC}
    ,                        !- Delta Temperature Schedule Name
    -100.0,                  !- Minimum Outdoor Temperature {C}
    ,                        !- Minimum Outdoor Temperature Schedule Name
    100.0,                   !- Maximum Outdoor Temperature {C}
    ,                        !- Maximum Outdoor Temperature Schedule Name
    40.0;                    !- Maximum Wind Speed {m/s}

!- Tor 5 in AW_Nord: C_w = 0, Q_soll = 0 m3/s
ZoneVentilation:WindandStackOpenArea,
    WSOA_Tor5,               !- Name
    Zone_Nord,               !- Zone or Space Name
    9,                       !- Opening Area {m2}
    Sch_Tor_auf,             !- Opening Area Fraction Schedule Name
    Autocalculate,           !- Opening Effectiveness
    0,                       !- Effective Angle {deg}
    0.0,                     !- Height Difference {m}
    Autocalculate,           !- Discharge Coefficient for Opening
    -100.0,                  !- Minimum Indoor Temperature {C}
    ,                        !- Minimum Indoor Temperature Schedule Name
    100.0,                   !- Maximum Indoor Temperature {C}
    ,                        !- Maximum Indoor Temperature Schedule Name
    -100.0,                  !- Delta Temperature {deltaC}
    ,                        !- Delta Temperature Schedule Name
    -100.0,                  !- Minimum Outdoor Temperature {C}
    ,                        !- Minimum Outdoor Temperature Schedule Name
    100.0,                   !- Maximum Outdoor Temperature {C}
    ,                        !- Maximum Outdoor Temperature Schedule Name
    40.0;                    !- Maximum Wind Speed {m/s}


!- ============================================================================
!-   ZONECROSSMIXING
!- ============================================================================

!- Design Flow Rate = 19.400264 m3/s, also derselbe Volumenstrom, den das
!- Lueftungsobjekt dieser Datei erzeugt. Quellzone ist die luvseitige
!- Haelfte (Tor 2), Empfaengerzone die leeseitige (Tor 5).
ZoneCrossMixing,
    Spalt_CrossMixing,       !- Name
    Zone_Nord,               !- Zone or Space Name
    Sch_Tor_auf,             !- Schedule Name
    Flow/Zone,               !- Design Flow Rate Calculation Method
    19.400264,               !- Design Flow Rate {m3/s}
    ,                        !- Flow Rate per Floor Area {m3/s-m2}
    ,                        !- Flow Rate per Person {m3/s-person}
    ,                        !- Air Changes per Hour {1/hr}
    Zone_Sued,               !- Source Zone or Space Name
    0.0;                     !- Delta Temperature {deltaC}


!- ============================================================================
!-   OUTPUT
!- ============================================================================

Output:VariableDictionary,
    IDF,                     !- Key Field
    Unsorted;                !- Sort Option

Output:Table:SummaryReports,
    AllSummary;              !- Report 1 Name

OutputControl:Table:Style,
    HTML;                    !- Column Separator

Output:SQLite,
    SimpleAndTabular;        !- Option Type

Output:Diagnostics,
    DisplayAllWarnings,      !- Key 1
    DisplayAdvancedReportVariables; !- Key 2

!- Massgebend fuer den Vergleich mit der Handrechnung:
!- Zone Ventilation CURRENT Density Volume Flow Rate. Das Feld
!- Density Basis bleibt leer, Default Outdoor, also ist der Massenstrom
!- Q_soll * rho_aussen. Bei T_zone = T_aussen ist rho_zone = rho_aussen
!- und die Current-Density-Variante trifft Q_soll. Die
!- Standard-Density-Variante rechnet auf die Normdichte der
!- Standardatmosphaere um und liegt rund 1 Prozent daneben - das ist
!- keine Modellabweichung, sondern eine Dichteumrechnung.
!- Falls eine Variable in eplusout.err als unbekannt gemeldet wird, den
!- Namen aus eplusout.rdd uebernehmen - Output:VariableDictionary ist aktiv.
Output:Variable,
    *,                       !- Key Value
    Site Wind Speed,         !- Variable Name
    Timestep;                !- Reporting Frequency

Output:Variable,
    *,                       !- Key Value
    Site Wind Direction,     !- Variable Name
    Timestep;                !- Reporting Frequency

Output:Variable,
