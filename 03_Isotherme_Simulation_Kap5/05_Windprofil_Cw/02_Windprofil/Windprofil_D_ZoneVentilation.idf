    Z_BLAST_Wall_N,          !- Name
    Wall,                    !- Surface Type
    Wand_Beton,              !- Construction Name
    Z_BLAST,                 !- Zone Name
    ,                        !- Space Name
    Adiabatic,               !- Outside Boundary Condition
    ,                        !- Outside Boundary Condition Object
    NoSun,                   !- Sun Exposure
    NoWind,                  !- Wind Exposure
    ,                        !- View Factor to Ground
    4,                       !- Number of Vertices
    10.000, 10.000, 3.400,      !- Vertex 1
    10.000, 10.000, 0.000,      !- Vertex 2
    0.000, 10.000, 0.000,      !- Vertex 3
    0.000, 10.000, 3.400;      !- Vertex 4

BuildingSurface:Detailed,
    Z_BLAST_Wall_W,          !- Name
    Wall,                    !- Surface Type
    Wand_Beton,              !- Construction Name
    Z_BLAST,                 !- Zone Name
    ,                        !- Space Name
    Adiabatic,               !- Outside Boundary Condition
    ,                        !- Outside Boundary Condition Object
    NoSun,                   !- Sun Exposure
    NoWind,                  !- Wind Exposure
    ,                        !- View Factor to Ground
