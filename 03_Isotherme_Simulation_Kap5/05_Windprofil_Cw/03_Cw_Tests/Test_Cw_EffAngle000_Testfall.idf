!-   ===========  TESTOBJEKT: C_w-Nachweis (Pruefprotokoll Nr. 3) ===========
! C_D = 0 und Height Difference = 0  ->  Q = C_w * A * F_sched * V  (reiner Windterm).
! Auswertung: C_w = Q / (9 m2 * "Zone Outdoor Air Wind Speed").
ZoneVentilation:WindandStackOpenArea,
    Cw_Test,                 !- Name
    EXT-Story 1 Core Zone,   !- Zone or Space Name
    9,                       !- Opening Area {m2}
    Tor_auf,                 !- Opening Area Fraction Schedule Name
    Autocalculate,           !- Opening Effectiveness
    0,                       !- Effective Angle {deg}
    0,                       !- Height Difference {m}
    0,                       !- Discharge Coefficient for Opening
    -100,                    !- Minimum Indoor Temperature {C}
    ,                        !- Minimum Indoor Temperature Schedule Name
    100,                     !- Maximum Indoor Temperature {C}
    ,                        !- Maximum Indoor Temperature Schedule Name
    -100,                    !- Delta Temperature {deltaC}
    ,                        !- Delta Temperature Schedule Name
    -100,                    !- Minimum Outdoor Temperature {C}
    ,                        !- Minimum Outdoor Temperature Schedule Name
    100,                     !- Maximum Outdoor Temperature {C}
    ,                        !- Maximum Outdoor Temperature Schedule Name
    40;                      !- Maximum Wind Speed {m/s}

Output:Variable,
    *,                       !- Key Value
    Zone Outdoor Air Wind Speed,  !- Variable Name
    Timestep;                !- Reporting Frequency

Output:Variable,
    *,                       !- Key Value
    Zone Ventilation Standard Density Volume Flow Rate,  !- Variable Name
    Timestep;                !- Reporting Frequency
