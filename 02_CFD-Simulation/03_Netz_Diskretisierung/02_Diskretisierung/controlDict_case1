FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application       buoyantBoussinesqSimpleFoam;
startFrom         latestTime;
startTime         0;
stopAt            endTime;
endTime           1000;
deltaT            1;
writeControl      timeStep;
writeInterval     100;          // Write every 100 iterations
adjustTimeStep    no;
purgeWrite        2;            // Keep only 2 most recent timesteps
writeFormat       ascii;
writePrecision    6;
writeCompression  off;
timeFormat        general;
timePrecision     6;
runTimeModifiable true;         // Enable runtime modification for immediate writes

// Placeholder for mass flow monitoring functions (auto-generated by pipeline)
// massFlow functions will be inserted here by hvac.py during case setup

functions
{
    CO2transport
    {
        type            scalarTransport;
        libs            ("libsolverFunctionObjects.so");
        
        field           CO2;
        
        // Difusividad CO2 en aire a 20°C: 1.6e-5 m²/s
        D               1.6e-5;
        
        // Convección activada (usa campo U del solver)
        diffusion       yes;
        
        // NO reiniciar en cada timestep
        resetOnStartUp  false;
        
        // Escribir CO2 cuando solver escribe (tiempo 30)
        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;
    }
    
    limitCO2
    {
        type            limitFields;
        libs            ("libfieldFunctionObjects.so");
        
        // Clipar CO2 entre [0,1] cada timestep para evitar overshoots numéricos
        fields          (CO2);
        limit           both;
        min             0;
        max             1;
        
        writeControl    none;
    }

    massFlow_vent_0F_2
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        
        // Write every 10 iterations to reduce file size
        writeControl    timeStep;
        writeInterval   10;
        
        // Calculate volumetric flow rate phi = U*n integrated over patch
        fields          (phi);
        operation       sum;
        
        regionType      patch;
        name            vent_0F_2;
        
        writeFields     false;
        
        // Output: postProcessing/massFlow_vent_0F_2/0/surfaceFieldValue.dat
        // Convert to mass flow: phi_sum * rho_ref (1.2 kg/m3)
    }

    massFlow_vent_0F_1
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        
        // Write every 10 iterations to reduce file size
        writeControl    timeStep;
        writeInterval   10;
        
        // Calculate volumetric flow rate phi = U*n integrated over patch
        fields          (phi);
        operation       sum;
        
        regionType      patch;
        name            vent_0F_1;
        
        writeFields     false;
        
        // Output: postProcessing/massFlow_vent_0F_1/0/surfaceFieldValue.dat
        // Convert to mass flow: phi_sum * rho_ref (1.2 kg/m3)
    }


}
